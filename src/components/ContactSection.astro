---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contacto" class="bg-stone-900 px-6 md:px-12 py-16 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-start">
    <div>
      <p class="font-body text-xs tracking-[0.3em] text-stone-500 uppercase mb-6">
        {t("contact.eyebrow")}
      </p>
      <h2
        class="font-display text-[clamp(2rem,5vw,3.5rem)] text-white leading-none tracking-wide mb-4"
      >
        {t("contact.title")}
      </h2>
      <p class="font-body text-sm leading-relaxed text-stone-400 max-w-sm">
        {t("contact.subtitle")}
      </p>
    </div>

    <form
      id="contact-form"
      method="POST"
      action="/api/contact"
      enctype="multipart/form-data"
      data-msg-sending={t("contact.sending")}
      data-msg-success={t("contact.success")}
      data-msg-error={t("contact.sendError")}
      class="flex flex-col gap-8"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-6">
        <label class="block">
          <span class="block font-body text-xs tracking-[0.2em] text-stone-400 uppercase mb-2">
            {t("contact.firstName")}
          </span>
          <input
            type="text"
            name="firstName"
            required
            autocomplete="given-name"
            class="w-full bg-transparent border-b border-stone-700 py-3 font-body text-sm text-white outline-none focus:border-white transition-colors"
          />
        </label>
        <label class="block">
          <span class="block font-body text-xs tracking-[0.2em] text-stone-400 uppercase mb-2">
            {t("contact.lastName")}
          </span>
          <input
            type="text"
            name="lastName"
            required
            autocomplete="family-name"
            class="w-full bg-transparent border-b border-stone-700 py-3 font-body text-sm text-white outline-none focus:border-white transition-colors"
          />
        </label>
      </div>

      <label class="block">
        <span class="block font-body text-xs tracking-[0.2em] text-stone-400 uppercase mb-2">
          {t("contact.email")}
        </span>
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          class="w-full bg-transparent border-b border-stone-700 py-3 font-body text-sm text-white outline-none focus:border-white transition-colors"
        />
      </label>

      <div>
        <span class="block font-body text-xs tracking-[0.2em] text-stone-400 uppercase mb-2">
          {t("contact.design")}
        </span>

        <div
          id="contact-dropzone"
          role="button"
          tabindex="0"
          aria-label={t("contact.drop")}
          data-error-type={t("contact.errorType")}
          data-error-size={t("contact.errorSize")}
          class="relative border border-dashed border-stone-700 hover:border-white focus:border-white transition-colors cursor-pointer outline-none"
        >
          <input
            id="contact-file"
            type="file"
            name="design"
            accept=".png,.jpg,.jpeg,.webp,.heic,.heif,image/png,image/jpeg,image/webp,image/heic,image/heif"
            class="sr-only"
          />

          <!-- Estado vacío -->
          <div id="dz-idle" class="flex flex-col items-center gap-3 px-6 py-10 md:py-14 text-center">
            <svg
              class="w-8 h-8 text-stone-600"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
            >
              <path d="M12 16V4m0 0L7 9m5-5l5 5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3" stroke-linecap="round"></path>
            </svg>
            <p class="font-body text-sm text-stone-400">{t("contact.drop")}</p>
            <p class="font-body text-[10px] tracking-[0.2em] text-stone-500 uppercase">
              {t("contact.formats")}
            </p>
          </div>

          <!-- Estado con archivo -->
          <div id="dz-preview" class="hidden flex-col items-center gap-4 px-6 py-8 text-center">
            <img
              id="dz-thumb"
              src=""
              alt=""
              class="hidden max-h-48 w-auto object-contain"
            />
            <p id="dz-no-preview" class="hidden font-body text-xs tracking-[0.2em] text-stone-400 uppercase">
              {t("contact.noPreview")}
            </p>
            <p id="dz-filename" class="font-body text-sm text-stone-300 break-all"></p>
            <button
              type="button"
              id="dz-remove"
              class="font-body text-[10px] tracking-[0.2em] uppercase text-stone-400 hover:text-white underline underline-offset-4 transition-colors cursor-pointer"
            >
              {t("contact.remove")}
            </button>
          </div>
        </div>

        <p id="dz-error" class="hidden mt-2 font-body text-xs text-red-400" role="alert"></p>
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="w-full md:w-auto md:self-start inline-flex items-center justify-center gap-3 font-body text-xs tracking-[0.25em] uppercase bg-white text-stone-900 px-8 py-4 hover:bg-stone-100 transition-colors duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-wait"
      >
        {t("contact.submit")}
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M2 6h8M7 3l3 3-3 3"></path>
        </svg>
      </button>

      <p id="contact-status" class="hidden font-body text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  #contact-dropzone.dragover {
    border-color: #fff;
    background-color: var(--color-stone-800, #292524);
  }
</style>

<script>
  const dropzone = document.getElementById("contact-dropzone");
  const input = document.getElementById("contact-file") as HTMLInputElement | null;
  const idle = document.getElementById("dz-idle");
  const preview = document.getElementById("dz-preview");
  const thumb = document.getElementById("dz-thumb") as HTMLImageElement | null;
  const noPreview = document.getElementById("dz-no-preview");
  const filename = document.getElementById("dz-filename");
  const removeBtn = document.getElementById("dz-remove");
  const errorEl = document.getElementById("dz-error");

  if (dropzone && input && idle && preview && thumb && noPreview && filename && removeBtn && errorEl) {
    const ALLOWED = ["png", "jpg", "jpeg", "webp", "heic", "heif"];
    const MAX_SIZE = 10 * 1024 * 1024; // 10 MB
    let objectUrl: string | null = null;

    function showError(msg: string) {
      errorEl!.textContent = msg;
      errorEl!.classList.remove("hidden");
    }

    function clearError() {
      errorEl!.textContent = "";
      errorEl!.classList.add("hidden");
    }

    function reset() {
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
      input!.value = "";
      thumb!.src = "";
      thumb!.classList.add("hidden");
      noPreview!.classList.add("hidden");
      preview!.classList.add("hidden");
      preview!.classList.remove("flex");
      idle!.classList.remove("hidden");
    }

    function handleFile(file: File) {
      clearError();
      const ext = file.name.split(".").pop()?.toLowerCase() ?? "";

      if (!ALLOWED.includes(ext)) {
        reset();
        showError(dropzone!.dataset.errorType ?? "");
        return;
      }
      if (file.size > MAX_SIZE) {
        reset();
        showError(dropzone!.dataset.errorSize ?? "");
        return;
      }

      if (objectUrl) URL.revokeObjectURL(objectUrl);

      // HEIC/HEIF no se puede previsualizar en la mayoría de navegadores
      if (ext === "heic" || ext === "heif") {
        objectUrl = null;
        thumb!.classList.add("hidden");
        noPreview!.classList.remove("hidden");
      } else {
        objectUrl = URL.createObjectURL(file);
        thumb!.src = objectUrl;
        thumb!.classList.remove("hidden");
        noPreview!.classList.add("hidden");
      }

      filename!.textContent = file.name;
      idle!.classList.add("hidden");
      preview!.classList.remove("hidden");
      preview!.classList.add("flex");
    }

    // Click / teclado abren el selector
    dropzone.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("#dz-remove")) return;
      input.click();
    });
    dropzone.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        input.click();
      }
    });

    input.addEventListener("change", () => {
      const file = input.files?.[0];
      if (file) handleFile(file);
    });

    // Drag & drop
    ["dragenter", "dragover"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.add("dragover");
      }),
    );
    ["dragleave", "drop"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.remove("dragover");
      }),
    );
    dropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (!file) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      handleFile(file);
    });

    removeBtn.addEventListener("click", () => {
      reset();
      clearError();
    });

    // ── Envío del formulario ────────────────────────────────
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const status = document.getElementById("contact-status");

    if (form && submitBtn && status) {
      function setStatus(msg: string, tone: "neutral" | "success" | "error") {
        status!.textContent = msg;
        status!.classList.remove("hidden", "text-stone-400", "text-green-400", "text-red-400");
        status!.classList.add(
          tone === "success" ? "text-green-400" : tone === "error" ? "text-red-400" : "text-stone-400",
        );
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();
        submitBtn.disabled = true;
        setStatus(form.dataset.msgSending ?? "…", "neutral");

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          form.reset();
          reset();
          setStatus(form.dataset.msgSuccess ?? "", "success");
        } catch {
          setStatus(form.dataset.msgError ?? "", "error");
        } finally {
          submitBtn.disabled = false;
        }
      });
    }
  }
</script>
