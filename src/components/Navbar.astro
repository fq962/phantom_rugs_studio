---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { key: 'nav.home' as const,    href: '/'          },
  { key: 'nav.rugs' as const,    href: '/alfombras'  },
  { key: 'nav.about' as const,   href: '/sobre-mi'   },
  { key: 'nav.contact' as const, href: '/contacto'   },
];

const altLang = lang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname.replace(/^\/(en|es)/, '') || '/';
const altLangPath = getLocalizedPath(currentPath, altLang);

const langLabels = {
  es: { flag: '🇪🇸', label: 'Español' },
  en: { flag: '🇬🇧', label: 'English' },
};
const current = langLabels[lang];
const alt     = langLabels[altLang];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-stone-100">
  <nav class="flex items-center justify-between px-6 py-5 md:px-12">

    <!-- Logo -->
    <a href={getLocalizedPath('/', lang)} class="logo group relative">
      <span class="block font-display text-2xl text-stone-900 tracking-widest leading-none">
        PHANTOM
      </span>
      <span class="block font-display text-xs text-stone-900 tracking-[0.4em] opacity-50 group-hover:opacity-100 transition-opacity">
        RUGS STUDIO
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-10">
      {links.map(({ key, href }) => (
        <li>
          <a
            href={getLocalizedPath(href, lang)}
            class="font-body text-xs uppercase tracking-[0.2em] text-stone-500 hover:text-stone-900 transition-colors relative group"
          >
            {t(key)}
            <span class="absolute -bottom-1 left-0 w-0 h-px bg-stone-900 group-hover:w-full transition-all duration-300" />
          </a>
        </li>
      ))}
    </ul>

    <!-- Lang dropdown + hamburger -->
    <div class="flex items-center gap-5">

      <!-- Dropdown -->
      <div id="lang-dropdown" class="relative">
        <button
          id="lang-toggle"
          class="flex items-center gap-1.5 font-body text-xs tracking-[0.15em] text-stone-500 hover:text-stone-900 transition-colors cursor-pointer select-none"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span>{current.flag}</span>
          <span class="uppercase">{lang}</span>
          <svg class="w-3 h-3 transition-transform duration-200" id="lang-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 4l4 4 4-4"/>
          </svg>
        </button>

        <ul
          id="lang-menu"
          role="listbox"
          class="absolute right-0 mt-3 w-36 bg-white border border-stone-100 shadow-lg
                 opacity-0 scale-95 origin-top-right pointer-events-none
                 transition-all duration-150 ease-out"
        >
          <!-- Current (active) -->
          <li role="option" aria-selected="true"
            class="flex items-center gap-3 px-4 py-3 cursor-default">
            <span>{current.flag}</span>
            <span class="font-body text-xs tracking-widest text-stone-900 uppercase">{lang}</span>
            <span class="font-body text-[10px] text-stone-400 ml-auto">{current.label}</span>
            <svg class="w-3 h-3 text-stone-900 shrink-0" viewBox="0 0 12 12" fill="currentColor">
              <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            </svg>
          </li>

          <li class="mx-4 h-px bg-stone-100" role="separator" />

          <!-- Alt lang -->
          <li role="option" aria-selected="false">
            <a
              href={altLangPath}
              class="flex items-center gap-3 px-4 py-3 hover:bg-stone-50 transition-colors"
            >
              <span>{alt.flag}</span>
              <span class="font-body text-xs tracking-widest text-stone-500 uppercase">{altLang}</span>
              <span class="font-body text-[10px] text-stone-400 ml-auto">{alt.label}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Hamburger (mobile only) -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col gap-[5px] w-6 cursor-pointer"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="ham-line block h-px w-full bg-stone-900 transition-all duration-300 origin-center" />
        <span class="ham-line block h-px w-4 ml-auto bg-stone-900 transition-all duration-300" />
        <span class="ham-line block h-px w-full bg-stone-900 transition-all duration-300 origin-center" />
      </button>
    </div>
  </nav>
</header>

<!-- Mobile fullscreen overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-stone-950 flex flex-col justify-end pb-16 px-8
         translate-y-full opacity-0 transition-all duration-500 ease-[cubic-bezier(0.76,0,0.24,1)]
         md:hidden"
  aria-hidden="true"
>
  <span class="absolute top-8 right-8 font-display text-[8rem] text-white opacity-[0.04] leading-none select-none">
    PRS
  </span>

  <ul class="flex flex-col gap-2">
    {links.map(({ key, href }, i) => (
      <li>
        <a
          href={getLocalizedPath(href, lang)}
          class="block font-display text-[clamp(3rem,12vw,5rem)] text-white leading-tight
                 hover:text-stone-400 transition-colors duration-200"
          style={`transition-delay: ${i * 60}ms`}
        >
          {t(key)}
        </a>
      </li>
    ))}
  </ul>

  <!-- Lang switcher mobile -->
  <div class="mt-10 flex items-center gap-4">
    <span class="font-body text-xs tracking-[0.2em] text-white opacity-30 uppercase flex items-center gap-2">
      {current.flag} {lang}
      <span class="text-white opacity-20">·</span>
    </span>
    <a
      href={altLangPath}
      class="font-body text-xs tracking-[0.2em] text-white opacity-50 hover:opacity-100 transition-opacity uppercase flex items-center gap-2"
    >
      {alt.flag} {altLang}
    </a>
  </div>
</div>

<script>
  // Lang dropdown
  const langToggle  = document.getElementById('lang-toggle')!;
  const langMenu    = document.getElementById('lang-menu')!;
  const langChevron = document.getElementById('lang-chevron')!;

  let langOpen = false;

  function closeLang() {
    langOpen = false;
    langToggle.setAttribute('aria-expanded', 'false');
    langMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    langMenu.classList.remove('opacity-100', 'scale-100');
    langChevron.classList.remove('rotate-180');
  }

  langToggle.addEventListener('click', (e) => {
    e.stopPropagation();
    langOpen = !langOpen;
    langToggle.setAttribute('aria-expanded', String(langOpen));
    if (langOpen) {
      langMenu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      langMenu.classList.add('opacity-100', 'scale-100');
      langChevron.classList.add('rotate-180');
    } else {
      closeLang();
    }
  });

  document.addEventListener('click', closeLang);

  // Hamburger menu
  const toggle = document.getElementById('menu-toggle')!;
  const menu   = document.getElementById('mobile-menu')!;
  const lines  = toggle.querySelectorAll('.ham-line');

  let open = false;

  toggle.addEventListener('click', () => {
    open = !open;
    toggle.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden', String(!open));

    if (open) {
      menu.classList.remove('translate-y-full', 'opacity-0');
      menu.classList.add('translate-y-0', 'opacity-100');
      document.body.style.overflow = 'hidden';
      lines[0].classList.add('rotate-45', 'translate-y-[7px]');
      lines[1].classList.add('opacity-0', 'w-0');
      lines[2].classList.add('-rotate-45', '-translate-y-[7px]');
    } else {
      menu.classList.add('translate-y-full', 'opacity-0');
      menu.classList.remove('translate-y-0', 'opacity-100');
      document.body.style.overflow = '';
      lines[0].classList.remove('rotate-45', 'translate-y-[7px]');
      lines[1].classList.remove('opacity-0', 'w-0');
      lines[2].classList.remove('-rotate-45', '-translate-y-[7px]');
    }
  });

  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => toggle.click());
  });
</script>
