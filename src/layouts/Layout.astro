---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Phantom Rugs Studio — Handcrafted rugs with soul.",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon_tab/PHANTOM_ICON.svg" />
    <link rel="icon" href="/icon_tab/PHANTOM_ICON.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <title>{title} — Phantom Rugs Studio</title>
  </head>
  <body>
    <Navbar />

    <main class="pt-[73px]">
      <slot />
    </main>

    <footer class="px-6 md:px-12 py-8 border-t border-stone-200">
      <p class="font-body text-xs tracking-widest text-stone-400 uppercase">
        &copy; {new Date().getFullYear()} Phantom Rugs Studio
      </p>
    </footer>
  </body>
</html>
