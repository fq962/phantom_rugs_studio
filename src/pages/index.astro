---
import Layout from "../layouts/Layout.astro";

const pieces = [
  { id: "01", title: "Umbra",     year: "2024", size: "200 × 300 cm", technique: "Tufting" },
  { id: "02", title: "Sediment",  year: "2024", size: "160 × 240 cm", technique: "Hand-knotted" },
  { id: "03", title: "Veil",      year: "2023", size: "120 × 180 cm", technique: "Flatweave" },
  { id: "04", title: "Threshold", year: "2023", size: "240 × 340 cm", technique: "Tufting" },
];
---

<Layout title="Inicio">

  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="flex flex-col justify-end px-6 md:px-12 pb-12 pt-8 md:pt-24 md:min-h-[40vh] border-b border-stone-100">
    <p class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-4">Estudio · Honduras</p>
    <h1 class="font-display text-[clamp(3.5rem,10vw,8rem)] text-stone-900 leading-none tracking-wide max-w-4xl">
      Alfombras<br/>hechas a mano
    </h1>
  </section>

  <!-- ─── PORTFOLIO GRID ───────────────────────────────────── -->
  <section id="portfolio" class="px-6 md:px-12 py-16">

    <div class="flex items-baseline justify-between mb-10">
      <h2 class="font-display text-2xl tracking-widest text-stone-900">PIEZAS</h2>
      <a href="/alfombras" class="font-body text-xs tracking-[0.2em] text-stone-400 hover:text-stone-900 transition-colors uppercase">
        Ver todo →
      </a>
    </div>

    <!-- Grid asimétrico -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-3">

      <!-- Pieza 01 — grande izquierda, abarca 2 filas -->
      <div
        class="piece md:col-span-7 md:row-span-2 group relative overflow-hidden bg-stone-100 cursor-none aspect-[4/5] md:aspect-auto md:min-h-[680px]"
        data-index="0"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[0].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div class="piece-overlay absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500" />
        <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75">
          <span class="font-display text-[5rem] leading-none text-white/10 absolute bottom-4 right-4 select-none">{pieces[0].id}</span>
          <p class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1">{pieces[0].technique} · {pieces[0].year}</p>
          <h3 class="font-display text-4xl text-white tracking-widest">{pieces[0].title}</h3>
          <p class="font-body text-xs text-white/50 mt-1">{pieces[0].size}</p>
        </div>
        <div class="cursor-dot absolute w-16 h-16 rounded-full border border-white/60 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-x-1/2 -translate-y-1/2 backdrop-blur-sm" style="top:50%;left:50%">
          <span class="font-body text-[9px] tracking-[0.2em] text-white uppercase">Ver</span>
        </div>
      </div>

      <!-- Pieza 02 — derecha arriba -->
      <div
        class="piece md:col-span-5 group relative overflow-hidden bg-stone-100 cursor-none aspect-[3/2] md:aspect-auto md:h-[328px]"
        data-index="1"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[1].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500" />
        <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75">
          <span class="font-display text-[4rem] leading-none text-white/10 absolute bottom-2 right-4 select-none">{pieces[1].id}</span>
          <p class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1">{pieces[1].technique} · {pieces[1].year}</p>
          <h3 class="font-display text-3xl text-white tracking-widest">{pieces[1].title}</h3>
        </div>
      </div>

      <!-- Pieza 03 — derecha abajo izquierda -->
      <div
        class="piece md:col-span-3 group relative overflow-hidden bg-stone-200 cursor-none aspect-[3/2] md:aspect-auto md:h-[340px]"
        data-index="2"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[2].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500" />
        <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75">
          <p class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1">{pieces[2].year}</p>
          <h3 class="font-display text-2xl text-white tracking-widest">{pieces[2].title}</h3>
        </div>
      </div>

      <!-- Pieza 04 — derecha abajo derecha -->
      <div
        class="piece md:col-span-2 group relative overflow-hidden bg-stone-300 cursor-none aspect-[3/2] md:aspect-auto md:h-[340px]"
        data-index="3"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[3].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500" />
        <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75">
          <span class="font-display text-[3.5rem] leading-none text-white/10 absolute bottom-2 right-3 select-none">{pieces[3].id}</span>
          <p class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1">{pieces[3].year}</p>
          <h3 class="font-display text-2xl text-white tracking-widest">{pieces[3].title}</h3>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* Entrada escalonada al hacer scroll */
  .piece {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .piece.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Cursor dot sigue al mouse dentro de la pieza grande */
  #portfolio .piece:first-child .cursor-dot {
    transition: opacity 0.3s, left 0s, top 0s;
  }
</style>

<script>
  // Intersection Observer — entrada con stagger
  const pieces = document.querySelectorAll<HTMLElement>('.piece');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const i  = Number(el.dataset.index ?? 0);
        setTimeout(() => el.classList.add('visible'), i * 120);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1 });

  pieces.forEach(p => observer.observe(p));

  // Cursor dot en la pieza grande
  const bigPiece = document.querySelector<HTMLElement>('.piece[data-index="0"]');
  const dot      = bigPiece?.querySelector<HTMLElement>('.cursor-dot');

  bigPiece?.addEventListener('mousemove', (e) => {
    if (!dot) return;
    const rect = bigPiece.getBoundingClientRect();
    dot.style.left = `${e.clientX - rect.left}px`;
    dot.style.top  = `${e.clientY - rect.top}px`;
  });
</script>
