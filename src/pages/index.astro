---
import Layout from "../layouts/Layout.astro";

const pieces = [
  {
    id: "01",
    title: "Umbra",
    year: "2024",
    size: "200 × 300 cm",
    technique: "Tufting",
  },
  {
    id: "02",
    title: "Sediment",
    year: "2024",
    size: "160 × 240 cm",
    technique: "Hand-knotted",
  },
  {
    id: "03",
    title: "Veil",
    year: "2023",
    size: "120 × 180 cm",
    technique: "Flatweave",
  },
  {
    id: "04",
    title: "Threshold",
    year: "2023",
    size: "240 × 340 cm",
    technique: "Tufting",
  },
];
---

<Layout title="Inicio">
  <!-- ─── HERO / CTA ───────────────────────────────────────── -->
  <section
    class="relative overflow-hidden bg-stone-900 py-32 md:py-40 px-6 md:px-12 text-center"
  >
    <img
      src="/obillo_morado_cilindro.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-1 absolute w-28 md:w-36 pointer-events-none select-none"
    />
    <img
      src="/obillo_amarillo_cilindro.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-2 absolute w-24 md:w-32 pointer-events-none select-none"
    />
    <img
      src="/obillo_blanco_cilindro.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-3 absolute w-20 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/obillo_morado_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-4 absolute w-20 md:w-24 pointer-events-none select-none"
    />
    <img
      src="/obillo_rojo_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-5 absolute w-16 md:w-20 pointer-events-none select-none"
    />
    <img
      src="/obillo_verde_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-6 absolute w-24 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/ovillo_marron_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-7 absolute w-18 md:w-24 pointer-events-none select-none"
    />
    <img
      src="/ovillo_naranja_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-8 absolute w-20 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/ovillo_rosa_cilindro.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-9 absolute w-22 md:w-30 pointer-events-none select-none"
    />
    <img
      src="/ovillo_dorado_pelota.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-10 absolute w-16 md:w-22 pointer-events-none select-none"
    />
    <!-- <img src="/ovillo_salmon_cilindro.png"   alt="" aria-hidden="true" class="yarn yarn-11 absolute w-20 md:w-26 pointer-events-none select-none" /> -->
    <img
      src="/ovillo_verdelima_cilindro.png"
      alt=""
      aria-hidden="true"
      class="yarn yarn-12 absolute w-18 md:w-24 pointer-events-none select-none"
    />

    <div class="relative z-10 max-w-2xl mx-auto">
      <p
        class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-6"
      >
        Estudio · Honduras
      </p>
      <h1
        class="font-display text-[clamp(3rem,9vw,7rem)] text-white leading-none tracking-wide mb-6"
      >
        ALFOMBRAS<br />HECHAS A MANO
      </h1>
      <p
        class="font-body text-sm text-stone-400 leading-relaxed mb-10 max-w-sm mx-auto"
      >
        Cada pieza es única. Diseñadas y tejidas en nuestro estudio.
      </p>
      <a
        href="/alfombras"
        class="inline-flex items-center gap-3 font-body text-xs tracking-[0.25em] uppercase bg-white text-stone-900 px-8 py-4 hover:bg-stone-100 transition-colors duration-200"
      >
        Ver alfombras
        <svg
          class="w-3 h-3"
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M2 6h8M7 3l3 3-3 3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ─── PORTFOLIO GRID ───────────────────────────────────── -->
  <section id="portfolio" class="px-6 md:px-12 py-16">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="font-display text-2xl tracking-widest text-stone-900">
        PIEZAS
      </h2>
      <a
        href="/alfombras"
        class="font-body text-xs tracking-[0.2em] text-stone-400 hover:text-stone-900 transition-colors uppercase"
      >
        Ver todo →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-3">
      <div
        class="piece md:col-span-7 md:row-span-2 group relative overflow-hidden bg-stone-100 cursor-none aspect-[4/5] md:aspect-auto md:min-h-[680px]"
        data-index="0"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[0].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75"
        >
          <span
            class="font-display text-[5rem] leading-none text-white/10 absolute bottom-4 right-4 select-none"
            >{pieces[0].id}</span
          >
          <p
            class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1"
          >
            {pieces[0].technique} · {pieces[0].year}
          </p>
          <h3 class="font-display text-4xl text-white tracking-widest">
            {pieces[0].title}
          </h3>
          <p class="font-body text-xs text-white/50 mt-1">{pieces[0].size}</p>
        </div>
        <div
          class="cursor-dot absolute w-16 h-16 rounded-full border border-white/60 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-x-1/2 -translate-y-1/2 backdrop-blur-sm"
          style="top:50%;left:50%"
        >
          <span
            class="font-body text-[9px] tracking-[0.2em] text-white uppercase"
            >Ver</span
          >
        </div>
      </div>

      <div
        class="piece md:col-span-5 group relative overflow-hidden bg-stone-100 cursor-none aspect-[3/2] md:aspect-auto md:h-[328px]"
        data-index="1"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[1].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75"
        >
          <span
            class="font-display text-[4rem] leading-none text-white/10 absolute bottom-2 right-4 select-none"
            >{pieces[1].id}</span
          >
          <p
            class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1"
          >
            {pieces[1].technique} · {pieces[1].year}
          </p>
          <h3 class="font-display text-3xl text-white tracking-widest">
            {pieces[1].title}
          </h3>
        </div>
      </div>

      <div
        class="piece md:col-span-3 group relative overflow-hidden bg-stone-200 cursor-none aspect-[3/2] md:aspect-auto md:h-[340px]"
        data-index="2"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[2].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75"
        >
          <p
            class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1"
          >
            {pieces[2].year}
          </p>
          <h3 class="font-display text-2xl text-white tracking-widest">
            {pieces[2].title}
          </h3>
        </div>
      </div>

      <div
        class="piece md:col-span-2 group relative overflow-hidden bg-stone-300 cursor-none aspect-[3/2] md:aspect-auto md:h-[340px]"
        data-index="3"
      >
        <img
          src="/rugs/rug_example.png"
          alt={pieces[3].title}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 right-0 p-5 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75"
        >
          <span
            class="font-display text-[3.5rem] leading-none text-white/10 absolute bottom-2 right-3 select-none"
            >{pieces[3].id}</span
          >
          <p
            class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1"
          >
            {pieces[3].year}
          </p>
          <h3 class="font-display text-2xl text-white tracking-widest">
            {pieces[3].title}
          </h3>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SOBRE MÍ ───────────────────────────────────────── -->
  <section class="px-6 md:px-12 py-16 md:py-24 border-t border-stone-100">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
      <div>
        <p
          class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-6"
        >
          Sobre mí
        </p>
        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)] text-stone-900 leading-none tracking-wide mb-8"
        >
          DETRÁS DE<br />CADA PIEZA
        </h2>
        <div class="space-y-4">
          <p class="font-body text-sm leading-relaxed text-stone-500">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation ullamco laboris.
          </p>
          <p class="font-body text-sm leading-relaxed text-stone-500">
            Duis aute irure dolor in reprehenderit in voluptate velit esse
            cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat
            cupidatat non proident, sunt in culpa qui officia deserunt mollit
            anim id est laborum.
          </p>
        </div>
        <a
          href="/sobre-mi"
          class="inline-flex items-center gap-3 mt-10 font-body text-xs tracking-[0.25em] uppercase text-stone-900 group"
        >
          Leer más
          <span
            class="block w-8 h-px bg-stone-900 group-hover:w-14 transition-all duration-300"
          ></span>
        </a>
      </div>
      <div class="relative">
        <div class="aspect-square overflow-hidden bg-stone-100">
          <img
            src="/rugs/rug_example.png"
            alt="Sobre mí"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-4 -left-4 w-24 h-24 border border-stone-200 -z-10 hidden md:block"
        >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Entrada al cargar */
  .yarn {
    opacity: 0;
    scale: 0.6;
    z-index: 0;
  }
  .yarn.in {
    animation: yarn-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes yarn-in {
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .yarn-1 {
    top: -5%;
    left: -2%;
    animation: float-a 6s ease-in-out infinite;
  }
  .yarn-2 {
    bottom: -8%;
    left: 4%;
    animation: float-b 7s ease-in-out infinite 0.5s;
  }
  .yarn-3 {
    top: 10%;
    right: -1%;
    animation: float-c 5.5s ease-in-out infinite 1s;
  }
  .yarn-4 {
    bottom: 5%;
    right: 6%;
    animation: float-d 6.5s ease-in-out infinite 1.5s;
  }
  .yarn-5 {
    top: 55%;
    left: 8%;
    animation: float-e 7.5s ease-in-out infinite 0.8s;
  }
  .yarn-6 {
    top: -10%;
    right: 18%;
    animation: float-f 5s ease-in-out infinite 0.3s;
  }
  .yarn-7 {
    bottom: 12%;
    left: 22%;
    animation: float-b 8s ease-in-out infinite 1.2s;
  }
  .yarn-8 {
    top: 30%;
    right: 12%;
    animation: float-e 6s ease-in-out infinite 0.7s;
  }
  .yarn-9 {
    bottom: -6%;
    right: 28%;
    animation: float-a 7s ease-in-out infinite 2s;
  }
  .yarn-10 {
    top: 20%;
    left: 30%;
    animation: float-d 6s ease-in-out infinite 0.4s;
  }
  .yarn-11 {
    bottom: 20%;
    right: 40%;
    animation: float-c 7.5s ease-in-out infinite 1.8s;
  }
  .yarn-12 {
    top: 60%;
    right: 30%;
    animation: float-f 5.5s ease-in-out infinite 0.9s;
  }

  @keyframes float-a {
    0%,
    100% {
      transform: translateY(0px) rotate(-15deg);
    }
    50% {
      transform: translateY(-14px) rotate(-10deg);
    }
  }
  @keyframes float-b {
    0%,
    100% {
      transform: translateY(0px) rotate(10deg);
    }
    50% {
      transform: translateY(-10px) rotate(15deg);
    }
  }
  @keyframes float-c {
    0%,
    100% {
      transform: translateY(0px) rotate(20deg);
    }
    50% {
      transform: translateY(-12px) rotate(14deg);
    }
  }
  @keyframes float-d {
    0%,
    100% {
      transform: translateY(0px) rotate(-8deg);
    }
    50% {
      transform: translateY(-16px) rotate(-14deg);
    }
  }
  @keyframes float-e {
    0%,
    100% {
      transform: translateY(0px) rotate(5deg);
    }
    50% {
      transform: translateY(-10px) rotate(10deg);
    }
  }
  @keyframes float-f {
    0%,
    100% {
      transform: translateY(0px) rotate(-20deg);
    }
    50% {
      transform: translateY(-12px) rotate(-26deg);
    }
  }

  .piece {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .piece.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // ── Portfolio pieces entrance ────────────────────────────
  const pieces = document.querySelectorAll<HTMLElement>(".piece");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          setTimeout(
            () => el.classList.add("visible"),
            Number(el.dataset.index ?? 0) * 120,
          );
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1 },
  );
  pieces.forEach((p) => observer.observe(p));

  // ── Cursor dot en pieza grande ───────────────────────────
  const bigPiece = document.querySelector<HTMLElement>(
    '.piece[data-index="0"]',
  );
  const dot = bigPiece?.querySelector<HTMLElement>(".cursor-dot");
  bigPiece?.addEventListener("mousemove", (e) => {
    if (!dot) return;
    const rect = bigPiece.getBoundingClientRect();
    dot.style.left = `${e.clientX - rect.left}px`;
    dot.style.top = `${e.clientY - rect.top}px`;
  });

  // ── Yarn entrada escalonada ─────────────────────────────
  document.querySelectorAll<HTMLElement>(".yarn").forEach((el, i) => {
    setTimeout(
      () => {
        el.classList.add("in");
        // Una vez terminada la entrada, pasamos a la animación float CSS
        el.addEventListener(
          "animationend",
          () => {
            el.style.opacity = "1";
            el.style.scale = "1";
            el.classList.remove("in");
          },
          { once: true },
        );
      },
      200 + i * 120,
    );
  });

  // ── Yarn hover individual ────────────────────────────────
  document.querySelectorAll<HTMLElement>(".yarn").forEach((el) => {
    let tx = 0,
      ty = 0;
    let curX = 0,
      curY = 0;
    let active = false;
    let raf = 0;

    function animate() {
      curX += (tx - curX) * 0.08;
      curY += (ty - curY) * 0.08;
      el.style.translate = `${curX.toFixed(2)}px ${curY.toFixed(2)}px`;

      if (active || Math.abs(curX) > 0.1 || Math.abs(curY) > 0.1) {
        raf = requestAnimationFrame(animate);
      } else {
        el.style.translate = "";
        raf = 0;
      }
    }

    el.addEventListener("mousemove", (e) => {
      const r = el.getBoundingClientRect();
      // Offset relativo al centro del ovillo, máximo ±12px
      const ox = ((e.clientX - r.left) / r.width - 0.5) * 12;
      const oy = ((e.clientY - r.top) / r.height - 0.5) * 12;
      tx = ox;
      ty = oy;
      if (!active) {
        active = true;
        if (!raf) raf = requestAnimationFrame(animate);
      }
    });

    el.addEventListener("mouseleave", () => {
      active = false;
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(animate);
    });
  });
</script>
