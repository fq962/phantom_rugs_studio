---
import Layout from "../layouts/Layout.astro";
import { phantomRug } from "../data/rugs";

const rugs = [phantomRug];
---

<Layout title="Alfombras" description="Todas las piezas de Phantom Rugs Studio.">

  <!-- Header -->
  <section class="px-6 md:px-12 pt-8 pb-10 border-b border-stone-100 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <p class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-3">
        {rugs.length} pieza{rugs.length === 1 ? "" : "s"}
      </p>
      <h1 class="font-display text-[clamp(2.5rem,7vw,5rem)] text-stone-900 leading-none tracking-wide">
        ALFOMBRAS
      </h1>
    </div>
  </section>

  <!-- Grid -->
  <section class="px-6 md:px-12 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-stone-100" id="rugs-grid">

      {rugs.map((rug, i) => (
        <article
          class="rug-card bg-white group cursor-pointer"
          data-index={i}
          data-gallery={JSON.stringify(rug.images)}
        >
          <!-- Image -->
          <div class="relative overflow-hidden aspect-square bg-stone-50">
            <img
              src={rug.images[0]}
              alt={rug.title}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
            />

            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/10 transition-colors duration-500" />

            <!-- Number decorativo -->
            <span class="absolute bottom-3 right-4 font-display text-[4rem] leading-none text-stone-900/[0.06] select-none group-hover:text-stone-900/10 transition-colors">
              {rug.id}
            </span>
          </div>

          <!-- Info -->
          <div class="px-5 py-4 flex items-start justify-between gap-4 border-t border-stone-100">
            <div>
              <h2 class="font-display text-xl tracking-widest text-stone-900 leading-tight">
                {rug.title}
              </h2>
              <p class="font-body text-[11px] tracking-[0.15em] text-stone-400 uppercase mt-1">
                {rug.technique}
              </p>
            </div>
            <div class="text-right shrink-0">
              <p class="font-body text-[11px] text-stone-400">{rug.year}</p>
            </div>
          </div>

        </article>
      ))}

    </div>
  </section>

</Layout>

<style>
  .rug-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .rug-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Entrada escalonada
  const cards = document.querySelectorAll<HTMLElement>('.rug-card');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const i  = Number(el.dataset.index ?? 0);
        setTimeout(() => el.classList.add('visible'), i * 80);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.05 });

  cards.forEach(c => observer.observe(c));

</script>
