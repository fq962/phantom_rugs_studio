---
import Layout from "../../layouts/Layout.astro";
import { phantomRug } from "../../data/rugs";
---

<Layout title="Home">
  <!-- ─── HERO / CTA ───────────────────────────────────────── -->
  <section
    class="relative overflow-hidden bg-stone-900 py-32 md:py-40 px-6 md:px-12 text-center"
  >
    <img
      src="/ovillo_morado_cilindro.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-1 absolute w-28 md:w-36 pointer-events-none select-none"
    />
    <img
      src="/ovillo_amarillo_cilindro.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-2 absolute w-24 md:w-32 pointer-events-none select-none"
    />
    <img
      src="/ovillo_blanco_cilindro.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-3 absolute w-20 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/ovillo_morado_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-4 absolute w-20 md:w-24 pointer-events-none select-none"
    />
    <img
      src="/ovillo_rojo_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-5 absolute w-16 md:w-20 pointer-events-none select-none"
    />
    <img
      src="/ovillo_verde_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-6 absolute w-24 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/ovillo_marron_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-7 absolute w-18 md:w-24 pointer-events-none select-none"
    />
    <img
      src="/ovillo_naranja_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-8 absolute w-20 md:w-28 pointer-events-none select-none"
    />
    <img
      src="/ovillo_rosa_cilindro.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-9 absolute w-22 md:w-30 pointer-events-none select-none"
    />
    <img
      src="/ovillo_dorado_pelota.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-10 absolute w-16 md:w-22 pointer-events-none select-none"
    />
    <!-- <img src="/ovillo_salmon_cilindro.webp"   alt="" aria-hidden="true" class="yarn yarn-11 absolute w-20 md:w-26 pointer-events-none select-none" /> -->
    <img
      src="/ovillo_verdelima_cilindro.webp"
      alt=""
      aria-hidden="true"
      class="yarn yarn-12 absolute w-18 md:w-24 pointer-events-none select-none"
    />

    <div class="relative z-10 max-w-2xl mx-auto">
      <p
        class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-6"
      >
        Studio · Honduras
      </p>
      <h1
        class="font-display text-[clamp(3rem,9vw,7rem)] text-white leading-none tracking-wide mb-6"
      >
        HANDCRAFTED<br />RUGS
      </h1>
      <p
        class="font-body text-sm text-stone-400 leading-relaxed mb-10 max-w-sm mx-auto"
      >
        Every piece is one of a kind. Designed and crafted in our studio.
      </p>
      <a
        href="/en/rugs"
        class="inline-flex items-center gap-3 font-body text-xs tracking-[0.25em] uppercase bg-white text-stone-900 px-8 py-4 hover:bg-stone-100 transition-colors duration-200"
      >
        View rugs
        <svg
          class="w-3 h-3"
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M2 6h8M7 3l3 3-3 3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ─── PORTFOLIO GRID ───────────────────────────────────── -->
  <section id="portfolio" class="px-6 md:px-12 py-16">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="font-display text-2xl tracking-widest text-stone-900">
        PIECES
      </h2>
      <a
        href="/en/rugs"
        class="font-body text-xs tracking-[0.2em] text-stone-400 hover:text-stone-900 transition-colors uppercase"
      >
        View all →
      </a>
    </div>

    <div
      class="piece group relative overflow-hidden bg-stone-100 cursor-none aspect-square w-full max-w-xs mx-auto md:mx-0"
      data-index="0"
      data-gallery={JSON.stringify(phantomRug.images)}
    >
      <img
        src={phantomRug.images[0]}
        alt={phantomRug.title}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700 ease-out"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 delay-75"
      >
        <span
          class="font-display text-[5rem] leading-none text-white/10 absolute bottom-4 right-4 select-none"
          >{phantomRug.id}</span
        >
        <p
          class="font-body text-[10px] tracking-[0.3em] text-white/60 uppercase mb-1"
        >
          {phantomRug.technique} · {phantomRug.year}
        </p>
        <h3 class="font-display text-4xl text-white tracking-widest">
          {phantomRug.title}
        </h3>
      </div>
      <div
        class="cursor-dot absolute w-16 h-16 rounded-full border border-white/60 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-x-1/2 -translate-y-1/2 backdrop-blur-sm"
        style="top:50%;left:50%"
      >
        <span
          class="font-body text-[9px] tracking-[0.2em] text-white uppercase"
          >View</span
        >
      </div>
    </div>
  </section>

  <!-- ─── ABOUT ───────────────────────────────────────────── -->
  <section
    id="sobre-mi"
    class="px-6 md:px-12 py-16 md:py-24 border-t border-stone-100"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
      <div>
        <p
          class="font-body text-xs tracking-[0.3em] text-stone-400 uppercase mb-6"
        >
          About me
        </p>
        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)] text-stone-900 leading-none tracking-wide mb-8"
        >
          BEHIND<br />EACH PIECE
        </h2>
        <div class="space-y-4">
          <p class="font-body text-sm leading-relaxed text-stone-500">
            Phantom Rugs Studio was born from an idea inspired by social
            media, where we discovered the art of tufting and saw the
            opportunity to turn a hobby into something much bigger. What
            started as a curiosity to create unique pieces gradually grew
            into a true passion and the motivation to build our own
            business.
          </p>
          <p class="font-body text-sm leading-relaxed text-stone-500">
            Today, every rug we create reflects creativity, craftsmanship,
            and our commitment to making custom pieces that genuinely
            connect with the people who own them.
          </p>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-square overflow-hidden bg-stone-100">
          <img
            src="/main_logo_black.webp"
            alt="About me"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-4 -left-4 w-24 h-24 border border-stone-200 -z-10 hidden md:block"
        >
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .yarn {
    opacity: 0;
    scale: 0.6;
    z-index: 0;
  }
  .yarn.in {
    animation: yarn-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes yarn-in {
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .yarn-1 {
    top: -5%;
    left: -2%;
    animation: float-a 6s ease-in-out infinite;
  }
  .yarn-2 {
    bottom: -8%;
    left: 4%;
    animation: float-b 7s ease-in-out infinite 0.5s;
  }
  .yarn-3 {
    top: 10%;
    right: -1%;
    animation: float-c 5.5s ease-in-out infinite 1s;
  }
  .yarn-4 {
    bottom: 5%;
    right: 6%;
    animation: float-d 6.5s ease-in-out infinite 1.5s;
  }
  .yarn-5 {
    top: 55%;
    left: 8%;
    animation: float-e 7.5s ease-in-out infinite 0.8s;
  }
  .yarn-6 {
    top: -10%;
    right: 18%;
    animation: float-f 5s ease-in-out infinite 0.3s;
  }
  .yarn-7 {
    bottom: 12%;
    left: 22%;
    animation: float-b 8s ease-in-out infinite 1.2s;
  }
  .yarn-8 {
    top: 30%;
    right: 12%;
    animation: float-e 6s ease-in-out infinite 0.7s;
  }
  .yarn-9 {
    bottom: -6%;
    right: 28%;
    animation: float-a 7s ease-in-out infinite 2s;
  }
  .yarn-10 {
    top: 20%;
    left: 30%;
    animation: float-d 6s ease-in-out infinite 0.4s;
  }
  .yarn-11 {
    bottom: 20%;
    right: 40%;
    animation: float-c 7.5s ease-in-out infinite 1.8s;
  }
  .yarn-12 {
    top: 60%;
    right: 30%;
    animation: float-f 5.5s ease-in-out infinite 0.9s;
  }

  @keyframes float-a {
    0%,
    100% {
      transform: translateY(0px) rotate(-15deg);
    }
    50% {
      transform: translateY(-14px) rotate(-10deg);
    }
  }
  @keyframes float-b {
    0%,
    100% {
      transform: translateY(0px) rotate(10deg);
    }
    50% {
      transform: translateY(-10px) rotate(15deg);
    }
  }
  @keyframes float-c {
    0%,
    100% {
      transform: translateY(0px) rotate(20deg);
    }
    50% {
      transform: translateY(-12px) rotate(14deg);
    }
  }
  @keyframes float-d {
    0%,
    100% {
      transform: translateY(0px) rotate(-8deg);
    }
    50% {
      transform: translateY(-16px) rotate(-14deg);
    }
  }
  @keyframes float-e {
    0%,
    100% {
      transform: translateY(0px) rotate(5deg);
    }
    50% {
      transform: translateY(-10px) rotate(10deg);
    }
  }
  @keyframes float-f {
    0%,
    100% {
      transform: translateY(0px) rotate(-20deg);
    }
    50% {
      transform: translateY(-12px) rotate(-26deg);
    }
  }

  .piece {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  .piece.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const pieces = document.querySelectorAll<HTMLElement>(".piece");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          setTimeout(
            () => el.classList.add("visible"),
            Number(el.dataset.index ?? 0) * 120,
          );
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1 },
  );
  pieces.forEach((p) => observer.observe(p));

  const bigPiece = document.querySelector<HTMLElement>(
    '.piece[data-index="0"]',
  );
  const dot = bigPiece?.querySelector<HTMLElement>(".cursor-dot");
  bigPiece?.addEventListener("mousemove", (e) => {
    if (!dot) return;
    const rect = bigPiece.getBoundingClientRect();
    dot.style.left = `${e.clientX - rect.left}px`;
    dot.style.top = `${e.clientY - rect.top}px`;
  });

  // ── Yarn entrada escalonada ─────────────────────────────
  document.querySelectorAll<HTMLElement>(".yarn").forEach((el, i) => {
    setTimeout(
      () => {
        el.classList.add("in");
        el.addEventListener(
          "animationend",
          () => {
            el.style.opacity = "1";
            el.style.scale = "1";
            el.classList.remove("in");
          },
          { once: true },
        );
      },
      200 + i * 120,
    );
  });

  // ── Yarn hover individual ────────────────────────────────
  document.querySelectorAll<HTMLElement>(".yarn").forEach((el) => {
    let tx = 0,
      ty = 0;
    let curX = 0,
      curY = 0;
    let active = false;
    let raf = 0;

    function animate() {
      curX += (tx - curX) * 0.08;
      curY += (ty - curY) * 0.08;
      el.style.translate = `${curX.toFixed(2)}px ${curY.toFixed(2)}px`;

      if (active || Math.abs(curX) > 0.1 || Math.abs(curY) > 0.1) {
        raf = requestAnimationFrame(animate);
      } else {
        el.style.translate = "";
        raf = 0;
      }
    }

    el.addEventListener("mousemove", (e) => {
      const r = el.getBoundingClientRect();
      const ox = ((e.clientX - r.left) / r.width - 0.5) * 12;
      const oy = ((e.clientY - r.top) / r.height - 0.5) * 12;
      tx = ox;
      ty = oy;
      if (!active) {
        active = true;
        if (!raf) raf = requestAnimationFrame(animate);
      }
    });

    el.addEventListener("mouseleave", () => {
      active = false;
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(animate);
    });
  });
</script>
